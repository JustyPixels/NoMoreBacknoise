<Window x:Class="NoMoreBacknoise.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NoMoreBacknoise"
 Title="NoMoreBacknoise++" Style="{StaticResource {x:Type Window}}" Width="1160" Height="850" MinWidth="920" MinHeight="680" Loaded="WindowLoaded" Closing="WindowClosing">
 <Grid Margin="20" Background="{StaticResource BackgroundBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <StackPanel>
    <Canvas Width="46" Height="44" HorizontalAlignment="Left" Margin="0,0,0,14"><Path Fill="#72F2C3" Data="M 0,16 L 8,16 8,28 0,28 Z M 12,8 L 20,8 20,36 12,36 Z M 24,0 L 32,0 32,44 24,44 Z M 36,12 L 44,12 44,32 36,32 Z"/></Canvas>
    <TextBlock FlowDirection="LeftToRight" Text="NOMORE" FontFamily="Consolas" FontWeight="Bold" FontSize="24"/><TextBlock FlowDirection="LeftToRight" Text="BACKNOISE++" FontFamily="Consolas" FontWeight="Bold" FontSize="24" Foreground="{StaticResource AccentBrush}"/>
    <TextBlock Text="{DynamicResource t.tagline}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,22"/>
    <TextBlock Text="{DynamicResource t.microphone}" Style="{StaticResource Label}"/><ComboBox x:Name="InputDevices" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="DeviceChanged"/>
    <TextBlock Text="{DynamicResource t.cleanedOutput}" Style="{StaticResource Label}"/><ComboBox x:Name="OutputDevices" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="DeviceChanged"/>
    <Button Content="{DynamicResource t.refreshDevices}" Click="RefreshDevices"/>
    <TextBlock Text="{DynamicResource t.engine}" Style="{StaticResource Label}" Margin="0,12,0,4"/><ComboBox x:Name="EngineBox" SelectedIndex="0" SelectionChanged="EngineChanged"><ComboBoxItem Tag="auto" Content="{DynamicResource t.automatic}"/><ComboBoxItem Tag="rnnoise" Content="RNNoise"/><ComboBoxItem Tag="deepfilter" Content="DeepFilterNet3"/></ComboBox>
    <TextBlock Text="{DynamicResource t.preset}" Style="{StaticResource Label}"/><ComboBox x:Name="PresetBox" SelectedIndex="1" SelectionChanged="PresetChanged"><ComboBoxItem Content="{DynamicResource t.natural}"/><ComboBoxItem Content="{DynamicResource t.balanced}"/><ComboBoxItem Content="{DynamicResource t.maximum}"/><ComboBoxItem Content="{DynamicResource t.custom}"/></ComboBox>
    <DockPanel><TextBlock Text="{DynamicResource t.strength}" Style="{StaticResource Label}"/><TextBlock x:Name="StrengthValue" DockPanel.Dock="Right" Text="75%" Foreground="{StaticResource AccentBrush}"/></DockPanel>
    <Slider x:Name="StrengthSlider" Minimum="0" Maximum="100" Value="75" ValueChanged="ProcessingChanged" AutomationProperties.Name="Suppression strength"/>
    <Button x:Name="StartButton" Content="{DynamicResource t.start}" Background="#72F2C3" Foreground="#101318" FontWeight="Bold" Click="StartStop" Padding="12,13"/>
    <WrapPanel><Button x:Name="MuteButton" Content="{DynamicResource t.mute}" Click="ToggleMute"/><Button x:Name="BypassButton" Content="{DynamicResource t.bypass}" Click="ToggleBypass"/></WrapPanel>
   </StackPanel>
   <StackPanel><TextBlock Text="{DynamicResource t.localOnly}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,12,0,6"/><TextBlock Text="v0.2.0-preview.1 · MIT" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas"/><Button Content="GitHub ↗" Click="OpenRepository" Margin="0,12,0,0"/></StackPanel>

  </StackPanel></ScrollViewer></Border>
  <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <DockPanel Margin="0,2,0,16"><TextBlock Text="{DynamicResource t.dashboard}" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="StateLabel" DockPanel.Dock="Right" Text="{DynamicResource t.stopped}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/></DockPanel>
   <Border x:Name="WarningPanel" Grid.Row="1" Visibility="Collapsed" Background="#392A1E" BorderBrush="#F3B75B" BorderThickness="2" Padding="12" Margin="0,0,0,12"><DockPanel><Button Content="{DynamicResource t.retry}" Click="RetryProcessing" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock x:Name="WarningText" Foreground="#FFE2AD" VerticalAlignment="Center"/></DockPanel></Border>
   <TabControl Grid.Row="2" x:Name="Tabs">
    <TabItem Header="{DynamicResource t.live}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <UniformGrid Columns="4" Margin="0,0,-8,0">
      <Border Style="{StaticResource Card}" Margin="0,0,8,12"><StackPanel><TextBlock Text="{DynamicResource t.engine}" Style="{StaticResource Label}"/><TextBlock x:Name="EngineStatus" Text="—" FontFamily="Consolas" FontSize="16"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,8,12"><StackPanel><TextBlock Text="{DynamicResource t.appDelay}" Style="{StaticResource Label}"/><TextBlock x:Name="DelayStatus" Text="—" FontFamily="Consolas" FontSize="18"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,8,12"><StackPanel><TextBlock Text="{DynamicResource t.processing}" Style="{StaticResource Label}"/><TextBlock x:Name="LoadStatus" Text="—" FontFamily="Consolas" FontSize="18"/></StackPanel></Border>
      <Border Style="{StaticResource Card}" Margin="0,0,8,12"><StackPanel><TextBlock Text="{DynamicResource t.speech}" Style="{StaticResource Label}"/><TextBlock x:Name="SpeechStatus" Text="—" FontFamily="Consolas" FontSize="18"/></StackPanel></Border>
     </UniformGrid>
     <Border Style="{StaticResource Card}"><StackPanel><DockPanel Margin="0,0,0,12"><TextBlock Text="{DynamicResource t.waveforms}" FontWeight="SemiBold"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="■ " Foreground="#F3B75B"/><TextBlock Text="{DynamicResource t.raw}" Margin="0,0,16,0"/><TextBlock Text="■ " Foreground="#72F2C3"/><TextBlock Text="{DynamicResource t.cleaned}"/></StackPanel></DockPanel><local:SignalView x:Name="Waveform" Height="155"/><Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock x:Name="RawLevelLabel" Text="{DynamicResource t.raw}"/><ProgressBar Background="#101318" BorderThickness="0" x:Name="RawMeter" Minimum="-60" Maximum="0" Value="-60" Height="8" Foreground="#F3B75B" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock x:Name="CleanLevelLabel" Text="{DynamicResource t.cleaned}"/><ProgressBar Background="#101318" BorderThickness="0" x:Name="CleanMeter" Minimum="-60" Maximum="0" Value="-60" Height="8" Foreground="#72F2C3" Margin="0,6,0,0"/></StackPanel></Grid></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource t.spectrum}" FontWeight="SemiBold" Margin="0,0,0,10"/><local:SignalView x:Name="Spectrum" Height="105"/><TextBlock Text="0 Hz                                      12 kHz                                      24 kHz" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0"/></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource t.listenCompare}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource t.headphonesHint}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="MonitorDevices" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,12,0" SelectionChanged="MonitorChanged"/><CheckBox Grid.Column="1" x:Name="MonitorEnabled" Content="{DynamicResource t.monitor}" Checked="MonitorChanged" Unchecked="MonitorChanged"/></Grid><WrapPanel Margin="0,10,0,0"><Button Content="{DynamicResource t.listenRaw}" Click="ListenRaw"/><Button Content="{DynamicResource t.listenClean}" Click="ListenClean"/><Button x:Name="RecordButton" Content="{DynamicResource t.recordTest}" Click="RecordTest"/><Button x:Name="ExportRecordingButton" Content="{DynamicResource t.exportWav}" Click="ExportRecording" IsEnabled="False"/><Button Content="{DynamicResource t.playTestRaw}" Click="PlayTestRaw"/><Button Content="{DynamicResource t.playTestClean}" Click="PlayTestClean"/><TextBlock x:Name="RecordingStatus" Text="0.0 / 60 s" VerticalAlignment="Center" Margin="4,0,0,6"/></WrapPanel></StackPanel></Border>
     <TextBlock x:Name="DiagnosticText" Text="{DynamicResource t.delayHint}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="{DynamicResource t.advanced}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel><CheckBox x:Name="AdvancedEnabled" Content="{DynamicResource t.enableAdvanced}" Checked="AdvancedToggled" Unchecked="AdvancedToggled"/><TextBlock Text="{DynamicResource t.advancedHint}" Foreground="{StaticResource MutedBrush}"/><StackPanel x:Name="AdvancedControls" IsEnabled="False" Margin="0,16,0,0">
      <TextBlock Text="{DynamicResource t.attenuation}"/><Slider x:Name="AttenuationSlider" Minimum="0" Maximum="60" Value="35" ValueChanged="ProcessingChanged"/><TextBlock Text="{DynamicResource t.speechSensitivity}"/><Slider x:Name="SpeechSlider" Minimum="0.05" Maximum="0.95" Value="0.35" ValueChanged="ProcessingChanged"/>
      <CheckBox x:Name="GateEnabled" Content="{DynamicResource t.speechGate}" IsChecked="True" Checked="ProcessingChanged" Unchecked="ProcessingChanged"/>
      <TextBlock Text="{DynamicResource t.attack}"/><Slider x:Name="AttackSlider" Minimum="0.1" Maximum="100" Value="2" ValueChanged="ProcessingChanged"/><TextBlock Text="{DynamicResource t.hold}"/><Slider x:Name="HoldSlider" Minimum="0" Maximum="2000" Value="180" ValueChanged="ProcessingChanged"/><TextBlock Text="{DynamicResource t.release}"/><Slider x:Name="ReleaseSlider" Minimum="1" Maximum="2000" Value="140" ValueChanged="ProcessingChanged"/>
      <TextBlock Text="{DynamicResource t.floor}"/><Slider x:Name="FloorSlider" Minimum="-80" Maximum="0" Value="-35" ValueChanged="ProcessingChanged"/><TextBlock Text="{DynamicResource t.outputGain}"/><Slider x:Name="GainSlider" Minimum="-12" Maximum="12" Value="0" ValueChanged="ProcessingChanged"/>
     </StackPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource t.profiles}" FontWeight="SemiBold"/><ComboBox x:Name="ProfileBox" SelectionChanged="ProfileSelected"/><TextBox x:Name="ProfileName" MaxLength="80"/><WrapPanel><Button Content="{DynamicResource t.saveProfile}" Click="SaveProfile"/><Button Content="{DynamicResource t.importProfile}" Click="ImportProfile"/><Button Content="{DynamicResource t.exportProfile}" Click="ExportProfile"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource t.experimental}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource t.isolationUnavailable}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,12"/><TextBlock Text="{DynamicResource t.gpuUnavailable}" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
    <TabItem Header="{DynamicResource t.settings}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource t.language}"/><ComboBox x:Name="LanguageBox" DisplayMemberPath="Value" SelectedValuePath="Key" SelectionChanged="LanguageChanged"/><CheckBox x:Name="StartupCheck" Content="{DynamicResource t.windowsStartup}"/><CheckBox x:Name="AutoProcessCheck" Content="{DynamicResource t.autoProcess}"/><CheckBox x:Name="TrayCheck" Content="{DynamicResource t.closeToTray}"/><CheckBox x:Name="UpdatesCheck" Content="{DynamicResource t.updateChecks}"/><CheckBox x:Name="CableUpdatesCheck" Content="{DynamicResource t.cableUpdateChecks}"/>
      <TextBlock Text="{DynamicResource t.muteHotkey}" Margin="0,12,0,0"/><TextBox x:Name="MuteHotkeyBox"/><TextBlock Text="{DynamicResource t.bypassHotkey}"/><TextBox x:Name="BypassHotkeyBox"/><TextBlock Text="{DynamicResource t.hotkeyHint}" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/><WrapPanel><Button Content="{DynamicResource t.applySettings}" Click="ApplySettings"/><Button Content="{DynamicResource t.checkUpdates}" Click="CheckUpdates"/><Button Content="GitHub Releases ↗" Click="OpenDownloads"/></WrapPanel>
     </StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource t.setup}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource t.routingGuide}" Margin="0,8,0,12" Foreground="{StaticResource MutedBrush}"/><WrapPanel><Button Content="{DynamicResource t.cableTitle}" Click="OpenCable"/><Button Content="{DynamicResource t.setupGuide}" Click="OpenGuide"/></WrapPanel></StackPanel></Border>
     <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource t.privacy}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource t.privacyText}" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/></StackPanel></Border>
    </StackPanel></ScrollViewer></TabItem>
   </TabControl>
  </Grid>
 </Grid>
</Window>



